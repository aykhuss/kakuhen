# Standalone Sphinx builder for kakuhen.
#
# conf.py and the Doxygen XML consumed by breathe are generated by CMake, so
# every target first configures a docs-only CMake tree and runs Doxygen there.

SPHINXOPTS    ?=
SPHINXBUILD   ?= sphinx-build
CMAKE         ?= cmake
SOURCEDIR     = .
BUILDDIR      = _build
CMAKEBUILDDIR ?= $(BUILDDIR)/cmake
CONFDIR       = $(CMAKEBUILDDIR)/docs/sphinx

# Put it first so that "make" without argument is like "make help".
help:
	@$(SPHINXBUILD) -M help "$(SOURCEDIR)" "$(BUILDDIR)" $(SPHINXOPTS) $(O)

.PHONY: help doxygen Makefile

doxygen:
	@$(CMAKE) -S ../.. -B "$(CMAKEBUILDDIR)" -DKAKUHEN_BUILD_DOCS=ON
	@$(CMAKE) --build "$(CMAKEBUILDDIR)" --target generate_doxygen_xml

# Catch-all target: route all unknown targets to Sphinx using the new
# "make mode" option.  $(O) is meant as a shortcut for $(SPHINXOPTS).
%: Makefile doxygen
	@$(SPHINXBUILD) -M $@ "$(SOURCEDIR)" "$(BUILDDIR)" -c "$(CONFDIR)" $(SPHINXOPTS) $(O)
